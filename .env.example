# Secret cho TicketRush (app) và MockPay. Cả hai app tự đọc file .env ở gốc repo.
# Tạo nhanh với giá trị ngẫu nhiên: scripts/init-env.sh
# KHÔNG commit file .env (đã có trong .gitignore).

# Khoá API merchant và secret ký webhook: app và MockPay phải dùng CÙNG giá trị
MOCKPAY_API_KEY=
MOCKPAY_WEBHOOK_SECRET=

# Secret ký JWT (HMAC-SHA256), tối thiểu 32 ký tự
JWT_SECRET=

# Khoá Ed25519 ký QR vé, base64 (xem Bước 16.2 trong tài liệu hướng dẫn)
QR_PRIVATE_KEY=
QR_PUBLIC_KEY=
